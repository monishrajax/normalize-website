# Copy to server/.env and fill in. NEVER commit the filled-in copy.

# ---- Database ----------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/normalize
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/normalize
MONGODB_URI=mongodb://127.0.0.1:27017/normalize

# ---- Server ------------------------------------------------------------
PORT=5050
NODE_ENV=development
# Comma-separated. Without this, CORS falls back to the Vite dev origin only.
CLIENT_ORIGIN=http://localhost:5173

# ---- Razorpay ----------------------------------------------------------
# Test keys (rzp_test_*) move no real money. Swap for rzp_live_* at go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook in the Razorpay dashboard. This is a
# DIFFERENT secret from the key secret above.
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket --------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary
# "true" books a courier the moment payment lands. Keep false for a pre-book:
# you take money now and dispatch weeks later, and couriers expect prompt
# handover once an AWB exists.
SHIPROCKET_CREATE_ON_PAYMENT=false

# ---- Pricing (display + charge, single source of truth) -----------------
SHIPPING_FEE=199
FREE_SHIPPING_THRESHOLD=1499
