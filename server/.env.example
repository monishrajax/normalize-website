# Copy to server/.env and fill in. NEVER commit the filled-in copy.

# ---- Database (Supabase Postgres) --------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the TRANSACTION POOLER (port 6543), not the direct connection (5432):
# serverless opens a connection per instance and the pooler is built for that.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Local development against your own Postgres works too:
#   postgres://postgres@127.0.0.1:5432/normalize
#
# Apply server/sql/001_init.sql once before seeding.
DATABASE_URL=

# ---- Server ------------------------------------------------------------
PORT=5050
NODE_ENV=development
# Comma-separated list of origins allowed to call this API from a browser.
# Development is the Vite dev server. In PRODUCTION set this to your real
# domain — list BOTH apex and www unless you redirect one to the other, or the
# variant you didn't list will fail every API call with a CORS error.
#   CLIENT_ORIGIN=https://normalize.world,https://www.normalize.world
CLIENT_ORIGIN=http://localhost:5173

# ---- Razorpay ----------------------------------------------------------
# Test keys (rzp_test_*) move no real money. Swap for rzp_live_* at go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook in the Razorpay dashboard. This is a
# DIFFERENT secret from the key secret above.
# Webhook URL to register there, once the domain is live:
#   https://normalize.world/api/orders/webhook      (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket --------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary
# "true" books a courier the moment payment lands. Keep false for a pre-book:
# you take money now and dispatch weeks later, and couriers expect prompt
# handover once an AWB exists.
SHIPROCKET_CREATE_ON_PAYMENT=false

# ---- Pricing (display + charge, single source of truth) -----------------
SHIPPING_FEE=199
FREE_SHIPPING_THRESHOLD=1499
