# Environment variables to add in Vercel → Project Settings → Environment Variables.
# NEVER commit a filled-in copy of this file.
#
# All variables apply to Production, Preview, and Development unless noted.
# Vercel sets NODE_ENV and PORT automatically — do not add those here.

# ---- Database (Supabase Postgres) -------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# USE THE TRANSACTION POOLER (port 6543), not the direct connection (5432).
# Serverless functions open a connection per instance and Supabase's direct
# connection limit is small; the pooler is built for exactly this. The server
# sets `prepare: false` to match transaction mode -- see server/src/db.js.
#
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Vercel origin -----------------------------------------------------
# The domain(s) Vercel assigns to your deployment.
# List BOTH apex and www if you use a custom domain, separated by commas.
# This is used to set the CORS allowed-origin list on the Express server.
#   CLIENT_ORIGIN=https://normalize.world,https://www.normalize.world
CLIENT_ORIGIN=https://<your-app>.vercel.app

# ---- Razorpay ----------------------------------------------------------
# Test keys (rzp_test_*) move no real money. Swap for rzp_live_* at go-live.
# Needs a KYC-activated account for live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set AFTER creating the webhook in the Razorpay dashboard.
# Settings → Webhooks → Add, URL: https://<your-app>.vercel.app/api/orders/webhook
# Event: payment.captured
# This is DIFFERENT from the key secret above.
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket --------------------------------------------------------
# Leave blank to record payments without booking couriers automatically.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary

# "true" books a courier the moment payment lands.
# Keep false for a pre-book (pay now, ship later).
SHIPROCKET_CREATE_ON_PAYMENT=false

# ---- Pricing -----------------------------------------------------------
SHIPPING_FEE=199
FREE_SHIPPING_THRESHOLD=1499

# ---- Optional tuning ---------------------------------------------------
# Connections per instance. Leave unset (defaults to 1): a serverless instance
# serves one request at a time, so a bigger pool just multiplies idle
# connections across every warm instance and eats Supabase's budget. Raise it
# only when running as a long-lived Node server.
# PG_POOL_MAX=1
